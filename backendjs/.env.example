# Server Configuration
PORT=8888
NODE_ENV=development

# AI Configuration
# Provider: deepseek, openai, openrouter, zhipu
AI_PROVIDER=deepseek

# API Key for the selected provider
# DeepSeek: Get your key at https://platform.deepseek.com/
# OpenAI: Get your key at https://platform.openai.com/
# OpenRouter: Get your key at https://openrouter.ai/keys
AI_API_KEY=your_api_key_here

# Model to use (optional, defaults shown below)
# DeepSeek: deepseek-chat, deepseek-coder
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# OpenRouter: deepseek/deepseek-chat, openai/gpt-4o-mini
AI_MODEL=deepseek-chat

# Legacy OpenRouter Configuration (deprecated - use AI_API_KEY instead)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=deepseek/deepseek-chat
